// LIBRARIES ----------------------------
#include <Adafruit_NeoPixel.h>
#include <SoftwareSerial.h>
#include <DFRobotDFPlayerMini.h>

// PINS CONFIGURATION ----------------------------
#define NEOPIXEL_PIN 3
#define NUM_PIXELS   24

const int resetButtonPin = 6;      
const int stopButtonPin  = 7;      
const int touchPin       = 13;
const int ldrPin         = A0; 

// DATE VARIABLES ----------------
int periodLength = 0;    
int cycleLength = 0;     
int lastPeriodDay = 0;  
int todayDate = 28; //assume date is fixed to 28th of the month      
int nextPeriodDate = 0;  

// CUSTOM ALARM ----------------------------
int customAlarmDay = 0;          
bool customAlarmEnabled = false; 

// SONG VARIABLES (NEW) ----------------------
const int defaultAlarmSong = 9; //default song for the 3 fixed reminders
int customAlarmSong = 9;        //default until changed by user for custom alarm

// DAILY FIXED ALARMS ----------------------------
bool pillAlarmEnabled = false;  
bool painAlarmEnabled = false;  
bool periodAlarmEnabled = false;  

// NEOPIXEL and MP3----------------------------
Adafruit_NeoPixel strip(NUM_PIXELS, NEOPIXEL_PIN, NEO_GRB + NEO_KHZ800);
SoftwareSerial dfSerial(10, 11); 
DFRobotDFPlayerMini dfPlayer;
bool dfReady = false;

// INITIAL STATE VARIABLES ----------------------------
unsigned long lastPeriodStart = 0;
unsigned long lastPrintedDay = 0;
bool alarmActive = false;
bool alarmTriggeredToday = false; 
bool touchActive = false;
unsigned long touchStartTime = 0;
int currentBrightness = 50; 

// TIME SIMULATION ----------------------------
unsigned long oneDay = 10000UL; //1 day = 10 seconds
int cycleStartDay = 1;

// INITIAL CONFIGURATION  ----------------------------
bool deviceConfig = false; 

// FUNCTIONS
void startCalCycle(); //1st time cycle setup
void resetCycle(); //manual reseting of later cycles

// DAY CALCULATION (Calendar Simulation) ----------------------------
int calculateCurrentDay() {
  int daysSinceStart;
  if (todayDate >= lastPeriodDay) {
    daysSinceStart = todayDate - lastPeriodDay;
  } else {
    daysSinceStart = (31 - lastPeriodDay) + todayDate;
  }
  
  if (cycleLength > 0 && daysSinceStart >= cycleLength) {
    daysSinceStart = daysSinceStart % cycleLength;
  }
  
  return daysSinceStart + 1;
}

// SETUP CHECK
void checkConfiguration() {
  if (periodLength > 0 && cycleLength > 0 && 
      lastPeriodDay > 0 && todayDate > 0) {
    if (!deviceConfig) {
      deviceConfig = true;
      Serial.println("status||CONFIGURED");
      
      startCalCycle();
    }
  } else {
    deviceConfig = false;
  }
}

// -----------------------------------------------------------------
//  First time using the App: Calendar Setup
// -----------------------------------------------------------------
void startCalCycle() {
  Serial.println("status||TRACKING_STARTED");

  cycleStartDay = calculateCurrentDay();

  if (alarmActive) {alarmActive = false; if (dfReady) dfPlayer.stop();}
  alarmTriggeredToday = false; 
  lastPeriodStart = millis(); 
  lastPrintedDay = 0;
  strip.setBrightness(50); 
  
  updatePhaseColor(cycleStartDay); 
}

// -----------------------------------------------------------------
//  Reset Button: Force start a new cycle (for late or early periods)
// -----------------------------------------------------------------
void resetCycle() {
  Serial.println("status||RESET_CONFIRMED");

  cycleStartDay = 1;

  if (alarmActive) {alarmActive = false; if (dfReady) dfPlayer.stop();}
  alarmTriggeredToday = false; 
  lastPeriodStart = millis(); 
  lastPrintedDay = 0;
  strip.setBrightness(50); 
  
  updatePhaseColor(cycleStartDay); 
}

// -----------------------------------------------------------------
// VISUALS & LOGIC
// -----------------------------------------------------------------

void firstConfig() {
  float breath = (sin(millis() / 800.0) + 1.0) / 2.0; //simulate breathing effect
  int brightness = (int)(breath * 100) + 20; 
  uint32_t whiteColor = strip.Color(brightness, brightness, brightness);
  for (int i = 0; i < NUM_PIXELS; i++) strip.setPixelColor(i, whiteColor);
  strip.show();
}

void updatePhaseColor(unsigned long currentDay) {
  if (touchActive) {
     return;
  }

  uint32_t color; 
  int ovulationDay = cycleLength - 14;  
  int ovulationStart = ovulationDay - 2;
  int ovulationEnd = ovulationDay + 1;

  if (currentDay <= periodLength) {
     color = strip.Color(255, 0, 0);     //Phase 1: Menstrual is Red
  }
  else if (currentDay >= ovulationStart && currentDay <= ovulationEnd) {
     color = strip.Color(128, 0, 128);   //Phase 2: Ovulation is Purple
  }
  else if (currentDay > ovulationEnd) {
     color = strip.Color(0, 0, 255);     //Phase 3: Luteal is Blue
  }
  else {
     color = strip.Color(255, 255, 0);   //Phase 4: Follicular is Yellow
  }

  for (int i = 0; i < NUM_PIXELS; i++) strip.setPixelColor(i, color);
  strip.show();
}

void showPainLoading(unsigned long duration) {
  if (duration > 1500) duration = 1500; 
  int litPixels = map(duration, 0, 1500, 0, NUM_PIXELS);
  int r = map(duration, 0, 1500, 0, 255);
  int g = map(duration, 0, 1500, 255, 0);
  uint32_t painColor = strip.Color(r, g, 0);
  for (int i = 0; i < NUM_PIXELS; i++) {
    if (i < litPixels) strip.setPixelColor(i, painColor);
    else strip.setPixelColor(i, 0); 
  }
  strip.show();
}

void adjustBrightness(unsigned long currentDay) {
  int ldrValue = analogRead(ldrPin);
  int mappedVal = map(ldrValue, 0, 900, 2, 255);
  int newBrightness = constrain(mappedVal, 2, 255);
  if (abs(newBrightness - currentBrightness) > 5) {
    currentBrightness = newBrightness;
    strip.setBrightness(currentBrightness);
    if (!touchActive) updatePhaseColor(currentDay);
  }
}

void calculateNextPeriod() {
  int calc = lastPeriodDay + cycleLength;
  if (calc > 31) nextPeriodDate = calc - 31;
  else nextPeriodDate = calc;
  //Serial.print("Next Period Day||"); Serial.println(nextPeriodDate);

}

// Song ID
void startShroomyAlarm(int songID) {
  Serial.println("status||ALARM_ON"); 
  alarmActive = true;
  if (dfReady) dfPlayer.play(songID); 
}

void stopShroomyAlarm() {
  Serial.println("status||ALARM_OFF"); 
  alarmActive = false;
  if (dfReady) dfPlayer.stop();
  alarmTriggeredToday = true;
}

// -----------------------------------------------------------------
// PROTOPIE INPUTS 
// -----------------------------------------------------------------

void checkProtoPieInput() {
  if (Serial.available() > 0) {
    String message = Serial.readStringUntil('\n');
    message.trim(); 

    String command = message;
    String valueStr = "";
    int separatorIndex = message.indexOf("||");

    if (separatorIndex != -1) {
       command = message.substring(0, separatorIndex);
       valueStr = message.substring(separatorIndex + 2);
    } 
    else {
       separatorIndex = message.indexOf(' ');
       if (separatorIndex != -1) {
          command = message.substring(0, separatorIndex);
          valueStr = message.substring(separatorIndex + 1);
       }
    }
    command.trim();
    valueStr.trim();
    

    if (command == "START_NEWCYCLE") {
      if (deviceConfig) resetCycle(); 
    }
    
    else if (command == "PERIOD_LENGTH") {
      int newLen = valueStr.toInt();
      if (newLen > 0) {periodLength = newLen; checkConfiguration();}
    }

    else if (command == "CYCLE_LENGTH") {
      int newLen = valueStr.toInt();
      if (newLen > 0) {cycleLength = newLen; calculateNextPeriod(); checkConfiguration();}
    }

    else if (command == "LAST_PERIOD_DAY") {
      lastPeriodDay = valueStr.toInt(); calculateNextPeriod(); checkConfiguration();
    }

    else if (command == "TODAY_DATE") {
      todayDate = valueStr.toInt(); checkConfiguration();
    }

    else if (command == "REMINDER_DAY") {
      int newDay = valueStr.toInt();
      if (newDay > 0) {customAlarmDay = newDay; customAlarmEnabled = true;}
    }
    
    // Sound Selection
    else if (command == "ALARM_SOUND") {
      int songID = valueStr.toInt();
      if (songID >= 1 && songID <= 11) {
         customAlarmSong = songID;
      }
    }

    else if (command == "CUSTOM_REMINDER_ON") customAlarmEnabled = true;
    else if (command == "CUSTOM_REMINDER_OFF") customAlarmEnabled = false;
    
    else if (command == "PILL_ALARM_ON") pillAlarmEnabled = true;
    else if (command == "PILL_ALARM_OFF") pillAlarmEnabled = false;
    
    else if (command == "PAIN_ALARM_ON") painAlarmEnabled = true;
    else if (command == "PAIN_ALARM_OFF") painAlarmEnabled = false;    

    else if (command == "PERIOD_START_ALARM_ON") periodAlarmEnabled = true;
    else if (command == "PERIOD_START_ALARM_OFF") periodAlarmEnabled = false;
  }
}

// -----------------------------------------------------------------
// SETUP & LOOP
// -----------------------------------------------------------------
void setup() {
  pinMode(resetButtonPin, INPUT_PULLUP);
  pinMode(stopButtonPin, INPUT_PULLUP);
  pinMode(touchPin, INPUT);
  pinMode(ldrPin, INPUT); 
  
  strip.begin(); strip.setBrightness(50); strip.show(); 

  Serial.begin(9600);
  Serial.setTimeout(50); 
  delay(1000); 
  
  dfSerial.begin(9600);
  if (dfPlayer.begin(dfSerial)) {dfReady = true; dfPlayer.volume(10);} 
  else { Serial.println("status||DFPLAYER_ERROR"); }

  pillAlarmEnabled = false;
  painAlarmEnabled = false;
  periodAlarmEnabled = false;
  customAlarmEnabled = false; 

  Serial.println("status||WAITING_FOR_SETUP");
}

void loop() {
  checkProtoPieInput(); 
  
  if (!deviceConfig) {
    firstConfig(); delay(50); return; 
  }
  
  // Simulation Logic
  unsigned long elapsed = millis() - lastPeriodStart;
  unsigned long simulatedDaysElapsed = elapsed / oneDay;
  unsigned long currentDay = cycleStartDay + simulatedDaysElapsed;


  // Touch Logic 
  if (digitalRead(touchPin) == HIGH) {
    if (!touchActive) {touchActive = true; touchStartTime = millis();}
    showPainLoading(millis() - touchStartTime);
  }
  
  else if (touchActive) { 
    unsigned long duration = millis() - touchStartTime;
    if (duration > 1500) duration = 1500;
    int painVal = map(duration, 0, 1500, 1, 5);
    Serial.print("PAIN_LEVEL||"); Serial.println(painVal);
    touchActive = false; updatePhaseColor(currentDay);
  }

  // Button Logic 
  if (currentDay > (unsigned long)cycleLength) { resetCycle(); return; } 
  if (digitalRead(resetButtonPin) == LOW) { delay(200); resetCycle(); return; } 
  if (digitalRead(stopButtonPin) == LOW) { delay(200); if (alarmActive) stopShroomyAlarm(); } 
  
  adjustBrightness(currentDay);

  // Update Day and Phase
  if (currentDay != lastPrintedDay && !touchActive) {
    if (alarmActive) stopShroomyAlarm();
    lastPrintedDay = currentDay;
    alarmTriggeredToday = false; 

    Serial.print("DAY||"); Serial.println(currentDay);

    int ovulationDay = cycleLength - 14;
    int ovulationStart = ovulationDay - 2;
    int ovulationEnd = ovulationDay + 1;

    if (currentDay <= periodLength)       Serial.println("MENSTRUAL_PHASE");
    else if (currentDay >= ovulationStart && currentDay <= ovulationEnd) Serial.println("OVULATION_PHASE");
    else if (currentDay > ovulationEnd)   Serial.println("LUTEAL_PHASE");
    else                                  Serial.println("FOLLICULAR_PHASE");

    updatePhaseColor(currentDay);
  }

  // Alarms Check
  if (!alarmActive && !alarmTriggeredToday) {
    int songToPlay = 0;

    // Fixed Alarms (DEFAULT song)
    if (pillAlarmEnabled) songToPlay = defaultAlarmSong;
    if (painAlarmEnabled) songToPlay = defaultAlarmSong;
    if (periodAlarmEnabled && currentDay == (cycleLength - 2)) songToPlay = defaultAlarmSong;
    
    // Custom Alarm (CUSTOM song)
    if (customAlarmEnabled && currentDay == customAlarmDay) {
        songToPlay = customAlarmSong;
    }

    if (songToPlay > 0) {
      startShroomyAlarm(songToPlay);
    }
  }

  delay(50);
}

